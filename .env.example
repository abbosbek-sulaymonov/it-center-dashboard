# Copy to .env.local and fill in. .env.local is git-ignored.

# MongoDB connection string (Atlas or a local mongod).
MONGODB_URI=mongodb://127.0.0.1:27017/it-center

# Secret used to sign session JWTs. Required in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the API listens on in development.
PORT=5001

# Comma-separated list of origins allowed to send credentialed requests.
CLIENT_ORIGIN=http://localhost:3000
